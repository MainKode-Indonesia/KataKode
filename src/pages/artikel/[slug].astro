---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReadingProgress from "../../components/ui/ReadingProgress.astro";
import { getDirectusArticles } from "../../lib/directus";
import type { DirectusArticle } from "../../lib/directus";
import { adaptDirectusArticle } from "../../lib/article-adapter";
import sanitizeHtml from "sanitize-html";

export async function getStaticPaths() {
  const articles = await getDirectusArticles();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article: directusArticle } = Astro.props as {
  article: DirectusArticle;
};

const unified = adaptDirectusArticle(directusArticle);

const {
  id,
  title,
  description,
  category,
  pubDate,
  readingTime,
  cover,
} = unified;

const updatedDate = pubDate;

const tags: string[] = [];

const directusHtml = sanitizeHtml(directusArticle.content ?? "", {
  allowedTags: [
    ...sanitizeHtml.defaults.allowedTags,
    "img",
    "h1",
    "h2",
    "h3",
    "h4",
    "pre",
    "code",
    "br",
    "figure",
    "figcaption",
    "table",
    "thead",
    "tbody",
    "tr",
    "th",
    "td",
  ],
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    img: ["src", "alt", "title", "width", "height"],
    a: ["href", "name", "target", "rel"],
    code: ["class"],
    pre: ["class"],
    th: ["colspan", "rowspan"],
    td: ["colspan", "rowspan"],
  },
  allowedSchemes: ["http", "https", "mailto"],
});

const date = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(pubDate);

const articleUrl = new URL(
  `/artikel/${id}/`,
  Astro.site ?? Astro.url
).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  mainEntityOfPage: articleUrl,
  author: {
    "@type": "Organization",
    name: "KataKode",
  },
  publisher: {
    "@type": "Organization",
    name: "KataKode",
    url: "https://blog.nafeka.my.id",
  },
};
---

<BaseLayout
  title={`${title} — KataKode`}
  description={description}
  image={cover}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate.toISOString()}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
  />

  <ReadingProgress targetSelector="main article" />

  <main class="container-site py-16 md:py-24">
    <article class="mx-auto max-w-3xl">
      <a
        href="/artikel/"
        class="text-sm font-medium text-muted hover:text-primary"
      >
        ← Kembali ke Artikel
      </a>

      <header class="mt-12 border-b border-border pb-10">
        <span class="eyebrow">{category}</span>

        <h1
          class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl"
        >
          {title}
        </h1>

        <p class="mt-6 text-lg leading-8 text-muted">
          {description}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-muted">
          <time datetime={pubDate.toISOString().slice(0, 10)}>
            {date}
          </time>

          <span>•</span>
          <span>{readingTime} menit baca</span>
        </div>
      </header>

      {cover && (
        <figure class="mt-8 overflow-hidden rounded-2xl">
          <img
            src={cover}
            alt={`Sampul artikel: ${title}`}
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="article-content mt-12" set:html={directusHtml}></div>

      <footer class="mt-16 border-t border-border pt-8">
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <a
          href="/artikel/"
          class="mt-10 inline-block text-sm font-semibold text-primary hover:underline"
        >
          ← Lihat artikel lainnya
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
