
---
import type { UnifiedArticle } from "../../lib/article-adapter";
import CategoryBadge from "./CategoryBadge.astro";
import { formatArticleDate } from "../../lib/articles";

interface Props {
  article: UnifiedArticle;
}

const { article } = Astro.props;
const { id, title, description, category, pubDate, readingTime, cover } = article;

const isNewsUpdate = category.trim().toLowerCase() === "news update";
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5"
>
  <a
    href={`/artikel/${id}/`}
    class="block"
    aria-label={`Baca ${title}`}
  >
    <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-[#eeedff]">
      {cover ? (
        <img
          src={cover}
          alt={`Sampul artikel: ${title}`}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <>
          <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-primary/10 blur-2xl"></div>
          <div class="absolute -bottom-16 -left-12 h-48 w-48 rounded-full bg-primary/15 blur-2xl"></div>
          <span class="relative text-5xl font-bold tracking-tight text-primary/30 transition-transform duration-500 group-hover:scale-110">
            &lt;/&gt;
          </span>
        </>
      )}
    </div>
  </a>

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      {isNewsUpdate ? (
        <>
          <span class="inline-flex rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400">
            NEWS
          </span>

          <span
            data-news-new
            hidden
            class="inline-flex rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400"
          >
            NEW
          </span>
        </>
      ) : (
        <CategoryBadge category={category} />
      )}
    </div>

    <h3 class="text-xl font-bold leading-snug tracking-tight">
      <a href={`/artikel/${id}/`} class="hover:text-primary">
        {title}
      </a>
    </h3>

    <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">
      {description}
    </p>

    <div class="mt-auto flex flex-wrap items-center gap-2 pt-6 text-xs text-muted">
      <time datetime={pubDate.toISOString().slice(0, 10)}>
        {formatArticleDate(pubDate)}
      </time>

      <span aria-hidden="true">•</span>

      <span>{readingTime} menit baca</span>
    </div>

    {isNewsUpdate && (
      <time
        data-news-published-at
        datetime={pubDate.toISOString()}
        class="hidden"
      ></time>
    )}
  </div>
</article>

<script>
  const updateNewsBadges = () => {
    const now = new Date();
    const today = new Date(
      now.getFullYear(),
      now.getMonth(),
      now.getDate()
    );

    const sevenDays = 7 * 24 * 60 * 60 * 1000;

    document.querySelectorAll("[data-news-published-at]").forEach((element) => {
      const dateValue = element.getAttribute("datetime") || "";
      const dateString = dateValue.slice(0, 10);

      const [year, month, day] = dateString.split("-").map(Number);

      const publishedDate = new Date(year, month - 1, day);

      const age = today.getTime() - publishedDate.getTime();

      const badge = element
        .closest("article")
        ?.querySelector("[data-news-new]");

      if (!badge || !Number.isFinite(age)) return;

      badge.toggleAttribute(
        "hidden",
        age < 0 || age >= sevenDays
      );
    });
  };

  updateNewsBadges();
</script>
